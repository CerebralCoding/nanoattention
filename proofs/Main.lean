import ResidentProofs
import Inkling

open Resident

/-- Emit values from the same definitions that the proof kernel checked. -/
def joined (xs : List String) (separator : String := ", ") : String :=
  String.intercalate separator xs

/-- Render the exact arithmetic/branch AST evaluated in the QKV theorems.
Only these expression forms occur; parentheses preserve the conditional offset. -/
def qkvExprSource (metal : Bool) (nested : Bool := false) : QkvExpr → String
  | .tile => "tile"
  | .qtiles => "qtiles"
  | .ktiles => "ktiles"
  | .literal n => toString n ++ (if metal then "u" else "")
  | .add a b => qkvExprSource metal true a ++ " + " ++ qkvExprSource metal true b
  | .sub a b => qkvExprSource metal true a ++ " - " ++ qkvExprSource metal true b
  | .ifLt a b yes no =>
      let condition := qkvExprSource metal false a ++ " < " ++ qkvExprSource metal false b
      let body := if metal then
        condition ++ " ? " ++ qkvExprSource metal true yes ++ " : " ++ qkvExprSource metal true no
      else
        "if (" ++ condition ++ ") " ++ qkvExprSource metal true yes ++
          " else " ++ qkvExprSource metal true no
      if nested then "(" ++ body ++ ")" else body

def qkvHelperSource (metal : Bool) (name : String) (expr : QkvExpr) : String :=
  if metal then
    "inline uint " ++ name ++ "(uint tile, uint qtiles, uint ktiles) { return " ++
      qkvExprSource true false expr ++ "; }"
  else
    "pub fn " ++ name ++ "(tile: u32, qtiles: u32, ktiles: u32) u32 {\n    return " ++
      qkvExprSource false false expr ++ ";\n}"

def zigSource : String := Id.run do
  let mut lines := [
    "// Generated by zig/proofs/Main.lean; do not edit. Run check_resident_proofs.py --generate.",
    "// Integer schedules certified for 1..49 layers; not a proof of GPU execution.",
    s!"pub const threadgroup_size: u32 = {threadgroupSize};",
    s!"pub const max_workers: u32 = {maxWorkers};",
    s!"pub const spin_limit: u32 = {spinLimit};",
    s!"pub const max_layers: u32 = {maxLayers};",
    s!"pub const replay_commands: u32 = {replayCommands};",
    s!"pub const replay_param_stride: u32 = {replayParamStride};",
    s!"pub const router_lanes: u32 = {routerLanes};",
    "// Dense split reduction: integer ownership/bounds only; not reduction arithmetic.",
    s!"pub const dense_simds: u32 = {denseSimds};",
    s!"pub const dense_max_cols: u32 = {denseMaxCols};",
    "// Split attention: integer ownership/index bounds only; no floating-point or memory-model claim.",
    s!"pub const attention_max_context: u32 = {attentionMaxContext};",
    s!"pub const attention_max_heads: u32 = {attentionMaxHeads};",
    s!"pub const attention_max_dim: u32 = {attentionMaxDim};",
    s!"pub const attention_simds: u32 = {attentionSimds};",
    s!"pub const attention_lanes: u32 = {attentionLanes};",
    "pub const attention_chunks = [_]u32{" ++ joined (attentionChunks.map toString) ++ "};",
    "pub fn validAttentionChunk(chunk: u32) bool {", "    return switch (chunk) {",
    "        " ++ joined (attentionChunks.map toString) ++ " => true,",
    "        else => false,", "    };", "}",
    "comptime {",
    "    if (dense_simds * router_lanes != threadgroup_size) @compileError(\"dense geometry mismatch\");",
    "    if (attention_simds * attention_lanes != threadgroup_size) @compileError(\"attention geometry mismatch\");",
    "}",
    s!"pub const router_slots: u32 = {routerSlots};",
    s!"pub const cached_router_experts: u32 = {cachedRouterExperts};",
    "pub const row_tiles = [_]u32{" ++ joined (rowTiles.map toString) ++ "};", "",
    "pub fn validRowTile(tile: u32) bool {", "    return switch (tile) {",
    "        " ++ joined (rowTiles.map toString) ++ " => true,",
    "        else => false,", "    };", "}", "",
    "// Requires tile < qtiles + ktiles + vtiles < 2^32 (sum in natural numbers).",
    qkvHelperSource false "stagedQkvProjection" qkvProjectionExpr,
    qkvHelperSource false "stagedQkvLocalTile" qkvLocalTileExpr, "",
    ""]
  let geometryLines := ["// MLX candidate/aligned norm: integer ownership only; no FP, Metal-model or liveness claim."] ++
    mlxGeometryConstants.map (fun (name, value) => s!"pub const {name}: u32 = {value};") ++
    ["pub const mlx_attention_blocks = [_]u32{" ++ joined (mlxAttentionBlocks.map toString) ++ "};",
     "pub fn validMlxAttentionBlocks(blocks: u32) bool {", "    return switch (blocks) {",
     "        " ++ joined (mlxAttentionBlocks.map toString) ++ " => true,",
     "        else => false,", "    };", "}",
     "// Flint GQA8 / apple_g15d host policy only; no universal MLX or performance claim.",
     "// Caller must separately enforce supported context, device, GQA and shape.",
     "pub fn mlxLargeDeviceBlocks(length: u32) u32 {",
     s!"    return if (length < {mlxLargeDevice512MinLength}) {mlxLargeDeviceBlocks 0}",
     s!"        else if (length < {mlxLargeDevice1024MinLength}) {mlxLargeDeviceBlocks mlxLargeDevice512MinLength}",
     s!"        else {mlxLargeDeviceBlocks mlxLargeDevice1024MinLength};", "}"]
  lines := lines ++ geometryLines ++ ["pub const Op = enum(u32) {"]
  for (name, opcode) in operations do
    lines := lines ++ [s!"    {name} = {opcode},"]
  lines := lines ++ ["};", ""]
  for layers in List.range maxLayers do
    let n := layers + 1
    let values := joined ((makePlan n).map toString)
    lines := lines ++ [s!"const plan_{n} = " ++ "[_]u32{" ++ values ++ "};"]
  lines := lines ++ ["", "pub fn program(layers: u32) ?[]const u32 {", "    return switch (layers) {"]
  for layers in List.range maxLayers do
    let n := layers + 1
    lines := lines ++ [s!"        {n} => &plan_{n},"]
  lines := lines ++ ["        else => null,", "    };", "}", ""]
  return joined lines "\n"

def metalSource : String := Id.run do
  let mut lines := [
    "// Generated by zig/proofs/Main.lean; do not edit. Run check_resident_proofs.py --generate.",
    "// Integer plan contract only; memory ordering, math and liveness are assumptions.",
    "#ifndef FLINT_RESIDENT_PLAN_METAL", "#define FLINT_RESIDENT_PLAN_METAL",
    s!"#define RESIDENT_THREADGROUP_SIZE {threadgroupSize}",
    s!"#define RESIDENT_MAX_WORKERS {maxWorkers}",
    s!"#define RESIDENT_SPIN_LIMIT {spinLimit}",
    s!"#define RESIDENT_MAX_LAYERS {maxLayers}",
    s!"#define STAGED_ROUTER_LANES {routerLanes}",
    "// Dense split reduction: integer ownership/bounds only; not reduction arithmetic.",
    s!"#define STAGED_DENSE_SIMDS {denseSimds}",
    s!"#define STAGED_DENSE_MAX_COLS {denseMaxCols}",
    "// Split attention: integer ownership/index bounds only; no floating-point or memory-model claim.",
    s!"#define STAGED_ATTENTION_SIMDS {attentionSimds}",
    s!"#define STAGED_ATTENTION_LANES {attentionLanes}",
    s!"#define STAGED_ATTENTION_MAX_CONTEXT {attentionMaxContext}",
    s!"#define STAGED_ATTENTION_MAX_HEADS {attentionMaxHeads}",
    s!"#define STAGED_ATTENTION_MAX_DIM {attentionMaxDim}",
    "#if STAGED_ATTENTION_SIMDS * STAGED_ATTENTION_LANES != RESIDENT_THREADGROUP_SIZE",
    "#error attention geometry mismatch", "#endif",
    "#if STAGED_DENSE_SIMDS * STAGED_ROUTER_LANES != RESIDENT_THREADGROUP_SIZE",
    "#error dense geometry mismatch",
    "#endif",
    s!"#define STAGED_ROUTER_SLOTS {routerSlots}",
    s!"#define STAGED_CACHED_ROUTER_EXPERTS {cachedRouterExperts}"]
  lines := lines ++ ["// MLX candidate/aligned norm: integer ownership only; no FP, Metal-model or liveness claim."]
  for (name, value) in mlxGeometryConstants do
    lines := lines ++ [s!"#define STAGED_{name.toUpper} {value}"]
  for blocks in mlxAttentionBlocks do
    lines := lines ++ [s!"#define STAGED_MLX_ATTENTION_BLOCKS_{blocks} {blocks}"]
  for chunk in attentionChunks do
    lines := lines ++ [s!"#define STAGED_ATTENTION_CHUNK_{chunk} {chunk}"]
  for tile in rowTiles do
    lines := lines ++ [s!"#define RESIDENT_ROW_TILE_{tile} {tile}"]
  lines := lines ++ ["",
    "// Requires tile < qtiles + ktiles + vtiles < 2^32 (sum in natural numbers).",
    qkvHelperSource true "staged_qkv_projection" qkvProjectionExpr,
    qkvHelperSource true "staged_qkv_local_tile" qkvLocalTileExpr,
    "", "enum ResidentOp {"]
  for (name, opcode) in operations do
    lines := lines ++ [s!"    RESIDENT_{name.toUpper} = {opcode},"]
  lines := lines ++ ["};", "", "#endif", ""]
  return joined lines "\n"

def replayCSource : String := joined [
  "// Generated by proofs/Main.lean; do not edit.",
  "#pragma once",
  s!"#define FM_REPLAY_COMMANDS {replayCommands}",
  s!"#define FM_REPLAY_PARAM_STRIDE {replayParamStride}", ""] "\n"

def multiProjExprSource (metal : Bool) (nested : Bool := false) : Inkling.MultiProjExpr → String
  | .tile => "tile"
  | .p1 => "p1"
  | .p2 => "p2"
  | .p3 => "p3"
  | .p4 => "p4"
  | .p5 => "p5"
  | .literal n => toString n ++ (if metal then "u" else "")
  | .sub a b => multiProjExprSource metal true a ++ " - " ++ multiProjExprSource metal true b
  | .ifLt a b yes no =>
      let condition := multiProjExprSource metal false a ++ " < " ++ multiProjExprSource metal false b
      let body := if metal then
        condition ++ " ? " ++ multiProjExprSource metal true yes ++ " : " ++ multiProjExprSource metal true no
      else
        "if (" ++ condition ++ ") " ++ multiProjExprSource metal true yes ++
          " else " ++ multiProjExprSource metal true no
      if nested then "(" ++ body ++ ")" else body

def multiProjHelperSource (metal : Bool) (name : String) (expr : Inkling.MultiProjExpr) : String :=
  if metal then
    "inline uint " ++ name ++ "(uint tile, uint p1, uint p2, uint p3, uint p4, uint p5) { return " ++
      multiProjExprSource true false expr ++ "; }"
  else
    "pub fn " ++ name ++ "(tile: u32, p1: u32, p2: u32, p3: u32, p4: u32, p5: u32) u32 {\n    return " ++
      multiProjExprSource false false expr ++ ";\n}"

def inklingZigSource : String := joined [
  "// Generated by proofs/Main.lean from proofs/Inkling.lean; do not edit. Run check_resident_proofs.py --generate.",
  "// Integer schedules, tiling, ring safety and NVFP4 bit-decode constants; no FP/memory-model claim.",
  s!"pub const hidden: u32 = {Inkling.hidden};",
  s!"pub const layers: u32 = {Inkling.layers};",
  s!"pub const loop_start: u32 = {Inkling.loopStart};",
  s!"pub const loop_end: u32 = {Inkling.loopEnd};",
  s!"pub const loop_passes: u32 = {Inkling.loopPasses};",
  s!"pub const logical_visits: u32 = {Inkling.logicalVisits};",
  s!"pub const heads: u32 = {Inkling.heads};",
  s!"pub const kv_heads: u32 = {Inkling.kvHeads};",
  s!"pub const gqa_ratio: u32 = {Inkling.gqaRatio};",
  s!"pub const head_dim: u32 = {Inkling.headDim};",
  s!"pub const rel_dim: u32 = {Inkling.relDim};",
  s!"pub const rel_extent: u32 = {Inkling.relExtent};",
  s!"pub const window: u32 = {Inkling.window};",
  s!"pub const conv_taps: u32 = {Inkling.convTaps};",
  s!"pub const experts: u32 = {Inkling.experts};",
  s!"pub const top_k: u32 = {Inkling.topK};",
  s!"pub const intermediate: u32 = {Inkling.intermediate};",
  s!"pub const vocab: u32 = {Inkling.vocab};",
  s!"pub const unpadded_vocab: u32 = {Inkling.unpaddedVocab};",
  s!"pub const gate_rank: u32 = {Inkling.gateRank};",
  s!"pub const d2_gen_shift: u32 = {Inkling.d2GenShift};",
  s!"pub const d2_token_mask: u32 = {Inkling.d2TokenMask};",
  s!"pub const d2_max_vocab: u32 = {Inkling.d2MaxVocab};",
  s!"pub const nvfp4_subsimd_lanes: u32 = {Inkling.nvfp4SubSimdLanes};",
  s!"pub const nvfp4_block_elems: u32 = {Inkling.nvfp4BlockElems};",
  s!"pub const nvfp4_subsimd_stride: u32 = {Inkling.nvfp4SubSimdStride};",
  s!"pub const nvfp4_subsimd8_lanes: u32 = {Inkling.nvfp4SubSimd8Lanes};",
  s!"pub const nvfp4_subsimd8_stride: u32 = {Inkling.nvfp4SubSimd8Stride};",
  s!"pub const max_multi_proj: u32 = {Inkling.maxMultiProj};",
  s!"pub const splitk_simds: u32 = {Inkling.splitkSimds};",
  s!"pub const splitk_lanes: u32 = {Inkling.splitkLanes};",
  s!"pub const splitk_threads: u32 = {Inkling.splitkThreads};",
  s!"pub const depth_reg_threads: u32 = {Inkling.depthRegThreads};",
  s!"pub const depth_reg_simds: u32 = {Inkling.depthRegSimds};",
  s!"pub const depth_simd_lanes: u32 = {Inkling.depthSimdLanes};",
  s!"pub const depth_vec_elems: u32 = {Inkling.depthVecElems};",
  s!"pub const depth_vec_threads: u32 = {Inkling.depthVecThreads};",
  s!"pub const expert_block_n64: u32 = {Inkling.expertBlockN64};",
  s!"pub const expert_block_simds: u32 = {Inkling.expertBlockSimds};",
  s!"pub const expert_block_simd_cols: u32 = {Inkling.expertBlockSimdCols};",
  s!"pub const expert_block_m: u32 = {Inkling.expertBlockM};",
  s!"pub const argmax_groups: u32 = {Inkling.argmaxGroups};",
  s!"pub const inkling_2p_visits: u32 = {Inkling.inkling2pVisits};",
  s!"pub const dflash_2p_traces: u32 = {Inkling.inkling2pTraces};",
  s!"pub const dflash_2p_remap_0: u32 = {Inkling.dflash2pRemap0};",
  s!"pub const dflash_2p_remap_1: u32 = {Inkling.dflash2pRemap1};",
  s!"pub const dflash_2p_remap_2: u32 = {Inkling.dflash2pRemap2};",
  s!"pub const bf16_mma_tile_n16: u32 = {Inkling.bf16MmaTileN16};",
  s!"pub const bf16_mma_tile_n32: u32 = {Inkling.bf16MmaTileN32};",
  s!"pub const unembed_padded_vocab: u32 = {Inkling.unembedPaddedVocab};",
  s!"pub const route_group_max_experts: u32 = {Inkling.routeGroupMaxExperts};",
  s!"pub const route_group_max_pairs: u32 = {Inkling.routeGroupMaxPairs};",
  s!"pub const dflash_heads: u32 = {Inkling.dflashHeads};",
  s!"pub const dflash_kv_heads: u32 = {Inkling.dflashKvHeads};",
  s!"pub const dflash_gqa4_ratio: u32 = {Inkling.dflashGqa4Ratio};",
  s!"pub const dflash_head_dim: u32 = {Inkling.dflashHeadDim};",
  s!"pub const dflash_ring_cap: u32 = {Inkling.dflashRingCap};",
  "comptime {",
  "    if (kv_heads * gqa_ratio != heads) @compileError(\"GQA ratio mismatch\");",
  "    if (depth_reg_threads * depth_vec_elems != hidden) @compileError(\"depth reg width mismatch\");",
  "    if (depth_reg_simds * depth_simd_lanes != depth_reg_threads) @compileError(\"depth simd count mismatch\");",
  "    if (splitk_simds * splitk_lanes != splitk_threads) @compileError(\"splitk thread count mismatch\");",
  "    if (expert_block_simds * expert_block_simd_cols != expert_block_n64) @compileError(\"expert n64 geometry mismatch\");",
  "    if (unembed_padded_vocab > vocab) @compileError(\"unembed padded vocab exceeds weights\");",
  "    if (dflash_kv_heads * dflash_gqa4_ratio != dflash_heads) @compileError(\"dflash gqa4 mismatch\");",
  "}",
  multiProjHelperSource false "multiProjIndex" Inkling.multiProjIndexExpr,
  multiProjHelperSource false "multiProjLocalTile" Inkling.multiProjLocalExpr,
  "pub fn ringBack(slot: u32, back: u32, capacity: u32) u32 {",
  "    return if (back <= slot) slot - back else slot + capacity - back;",
  "}",
  "pub fn stripeStart(visible: u32, taps: u32, part: u32) u32 {",
  "    return @intCast(@as(u64, visible) * part / taps);",
  "}",
  "pub fn stripeEnd(visible: u32, taps: u32, part: u32) u32 {",
  "    return @intCast(@as(u64, visible) * (part + 1) / taps);",
  "}",
  "pub fn farBandEnd(first_diag: u32, rel_ext: u32, bk: u32) u32 {",
  "    return if (rel_ext + bk <= first_diag + 1) ((first_diag + 1 - rel_ext) / bk) * bk else 0;",
  "}",
  "pub fn argmaxSpan(n: u32) u32 {",
  "    return (n + argmax_groups - 1) / argmax_groups;",
  "}",
  "pub fn moeTileBlock(c: u32) u32 {",
  "    return if (c <= 16) 16 else if (c <= 32) 32 else 64;",
  "}",
  "pub fn moePackTileR(tid_y: u32, bm: u32) u32 {",
  "    const code: u32 = if (bm == 16) 1 else if (bm == 32) 2 else 3;",
  "    return (code << 24) | (tid_y & 0xFFFFFF);",
  "}",
  "pub fn moeUnpackBm(packed_tile: u32) u32 {",
  "    const code: u32 = packed_tile >> 24;",
  "    return if (code == 1) 16 else if (code == 2) 32 else 64;",
  "}",
  "pub fn moeUnpackTidY(packed_tile: u32) u32 {",
  "    return packed_tile & 0xFFFFFF;",
  "}",
  "pub fn moeMaxTiles(exp_count: u32, total_pairs: u32) u32 {",
  "    return @min(total_pairs, @min(exp_count, total_pairs) + (total_pairs + 63) / 64);",
  "}",
  ""] "\n"

def inklingMetalSource : String := joined [
  "// Generated by proofs/Main.lean from proofs/Inkling.lean; do not edit. Run check_resident_proofs.py --generate.",
  "// Integer contract and bit-decode helpers only; memory ordering, FP association and liveness are assumptions.",
  "#ifndef NANO_INKLING_PLAN_METAL",
  "#define NANO_INKLING_PLAN_METAL",
  s!"#define INKLING_HIDDEN {Inkling.hidden}u",
  s!"#define INKLING_LOGICAL_VISITS {Inkling.logicalVisits}u",
  s!"#define INKLING_HEADS {Inkling.heads}u",
  s!"#define INKLING_KV_HEADS {Inkling.kvHeads}u",
  s!"#define INKLING_GQA_RATIO {Inkling.gqaRatio}u",
  s!"#define INKLING_HEAD_DIM {Inkling.headDim}u",
  s!"#define INKLING_REL_DIM {Inkling.relDim}u",
  s!"#define INKLING_REL_EXTENT {Inkling.relExtent}u",
  s!"#define INKLING_WINDOW {Inkling.window}u",
  s!"#define INKLING_CONV_TAPS {Inkling.convTaps}u",
  s!"#define INKLING_EXPERTS {Inkling.experts}u",
  s!"#define INKLING_TOP_K {Inkling.topK}u",
  s!"#define INKLING_INTERMEDIATE {Inkling.intermediate}u",
  s!"#define INKLING_MAX_MULTI_PROJ {Inkling.maxMultiProj}u",
  s!"#define INKLING_SPLITK_SIMDS {Inkling.splitkSimds}u",
  s!"#define INKLING_SPLITK_LANES {Inkling.splitkLanes}u",
  s!"#define INKLING_SPLITK_THREADS {Inkling.splitkThreads}u",
  s!"#define INKLING_DEPTH_REG_THREADS {Inkling.depthRegThreads}u",
  s!"#define INKLING_DEPTH_REG_SIMDS {Inkling.depthRegSimds}u",
  s!"#define INKLING_NVFP4_SUBSIMD_LANES {Inkling.nvfp4SubSimdLanes}u",
  s!"#define INKLING_NVFP4_SUBSIMD8_LANES {Inkling.nvfp4SubSimd8Lanes}u",
  s!"#define INKLING_NVFP4_BLOCK_ELEMS {Inkling.nvfp4BlockElems}u",
  s!"#define INKLING_EXPERT_BLOCK_N64 {Inkling.expertBlockN64}u",
  s!"#define INKLING_EXPERT_BLOCK_SIMDS {Inkling.expertBlockSimds}u",
  s!"#define INKLING_EXPERT_BLOCK_SIMD_COLS {Inkling.expertBlockSimdCols}u",
  s!"#define INKLING_EXPERT_BLOCK_M {Inkling.expertBlockM}u",
  s!"#define INKLING_ARGMAX_GROUPS {Inkling.argmaxGroups}u",
  s!"#define INKLING_BF16_MMA_TILE_N16 {Inkling.bf16MmaTileN16}u",
  s!"#define INKLING_BF16_MMA_TILE_N32 {Inkling.bf16MmaTileN32}u",
  s!"#define INKLING_UNEMBED_PADDED_VOCAB {Inkling.unembedPaddedVocab}u",
  s!"#define INKLING_ROUTE_GROUP_MAX_EXPERTS {Inkling.routeGroupMaxExperts}u",
  s!"#define INKLING_ROUTE_GROUP_MAX_PAIRS {Inkling.routeGroupMaxPairs}u",
  s!"#define DFLASH_HEADS {Inkling.dflashHeads}u",
  s!"#define DFLASH_KV_HEADS {Inkling.dflashKvHeads}u",
  s!"#define DFLASH_GQA4_RATIO {Inkling.dflashGqa4Ratio}u",
  s!"#define DFLASH_HEAD_DIM {Inkling.dflashHeadDim}u",
  s!"#define DFLASH_RING_CAP {Inkling.dflashRingCap}u",
  "#if INKLING_DEPTH_REG_THREADS * 4u != INKLING_HIDDEN",
  "#error inkling depth reg width mismatch",
  "#endif",
  "#if INKLING_EXPERT_BLOCK_SIMDS * INKLING_EXPERT_BLOCK_SIMD_COLS != INKLING_EXPERT_BLOCK_N64",
  "#error inkling expert n64 geometry mismatch",
  "#endif",
  multiProjHelperSource true "inkling_multi_proj_index" Inkling.multiProjIndexExpr,
  multiProjHelperSource true "inkling_multi_proj_local_tile" Inkling.multiProjLocalExpr,
  "inline uint inkling_ring_back(uint slot, uint back, uint capacity) { return slot >= back ? slot - back : slot + capacity - back; }",
  "inline uint inkling_stripe_start(uint visible, uint taps, uint part) { return uint(ulong(visible) * part / taps); }",
  "inline uint inkling_stripe_end(uint visible, uint taps, uint part) { return uint(ulong(visible) * (part + 1) / taps); }",
  "inline uint inkling_far_band_end(uint first_diag, uint rel_extent, uint bk) { return rel_extent + bk <= first_diag + 1 ? ((first_diag + 1 - rel_extent) / bk) * bk : 0u; }",
  "inline float4 inkling_nvfp4_decode4(uint packed) {",
  "    const uint4 code = (uint4(packed) >> uint4(0u, 4u, 8u, 12u)) & 15u;",
  "    const uint4 mag = code & 7u;",
  "    const uint4 ordinary = 0x3f000000u + (mag << 22);",
  "    const uint4 bits = select(ordinary, mag * 0x3f000000u, mag < 2u);",
  "    return as_type<float4>(bits | ((code & 8u) << 28));",
  "}",
  "inline int inkling_moe_tile_block(int c) { return c <= 16 ? 16 : (c <= 32 ? 32 : 64); }",
  "inline uint inkling_moe_pack_tile_r(uint tid_y, uint bm) {",
  "    const uint code = (bm == 16u) ? 1u : ((bm == 32u) ? 2u : 3u);",
  "    return (code << 24u) | (tid_y & 0xFFFFFFu);",
  "}",
  "inline int inkling_moe_unpack_bm(uint packed) {",
  "    const uint code = packed >> 24u;",
  "    return (code == 1u) ? 16 : ((code == 2u) ? 32 : 64);",
  "}",
  "inline uint inkling_moe_unpack_tid_y(uint packed) { return packed & 0xFFFFFFu; }",
  "inline uint inkling_moe_max_tiles(uint experts, uint total_pairs) {",
  "    return min(total_pairs, min(experts, total_pairs) + (total_pairs + 63u) / 64u);",
  "}",
  "#endif",
  ""] "\n"

def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  match args with
  | ["--zig"] => out.putStr zigSource
  | ["--metal"] => out.putStr metalSource
  | ["--replay-c"] => out.putStr replayCSource
  | ["--inkling-zig"] => out.putStr inklingZigSource
  | ["--inkling-metal"] => out.putStr inklingMetalSource
  | _ => throw (IO.userError "usage: resident_emit --zig | --metal | --replay-c | --inkling-zig | --inkling-metal")
